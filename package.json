{
  "name": "next-departure",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "feed:cache": "node scripts/cache-static.mjs",
    "feed:cache:regional": "node scripts/cache-static.mjs --branches 4,5,6",
    "feed:refresh": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/generate-departures.mjs",
    "feed:refresh:regional": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/generate-departures.mjs --regional",
    "feed:watch": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/generate-departures.mjs --watch",
    "feed:refresh:all": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/generate-departures.mjs --all"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "gtfs-realtime-bindings": "^2.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
